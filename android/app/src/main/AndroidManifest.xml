<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bevy renders with wgpu on Vulkan. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Defend Taipei"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        tools:targetApi="34">
        <!-- Only copied performance reports can be shared, with a temporary
             read grant selected by the user in the Android share chooser. -->
        <provider
            android:name=".PerformanceReportProvider"
            android:authorities="${applicationId}.performance_reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/perf_report_paths" />
        </provider>
        <!-- screenOrientation="sensor": follows the device in landscape and portrait.
             configChanges keeps the activity alive on rotation; Bevy gets a resize instead. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensor"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <meta-data
                android:name="android.app.lib_name"
                android:value="defend_taipei_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
